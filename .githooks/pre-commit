#!/bin/sh
# Regenerates the Photography page's photo list whenever a commit adds or removes photos.
# Enable once per clone with: git config core.hooksPath .githooks

if git diff --cached --name-only -- images/photography | grep -q .; then
    # GUI clients like GitHub Desktop skip the shell profile, so add the usual Node locations
    PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
    node scripts/sync-photos.js || exit 1
    git add photography/photos.json
fi
